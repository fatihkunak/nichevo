# Kopyala: .env  (gerçek değerler git'e girmez)
PORT=3102
HOST=127.0.0.1
# Migrasyonlar için sahip rolü (yalnızca `npm run migrate` ve testler kullanır)
OWNER_DATABASE_URL=postgres://nichevo_owner:CHANGE_ME@127.0.0.1:5545/nichevo
# Çalışma zamanı rolü: yalnızca tablo yetkileri var, süper kullanıcı değil
DATABASE_URL=postgres://nichevo_app:CHANGE_ME@127.0.0.1:5545/nichevo
APP_DB_PASSWORD=CHANGE_ME
# En az 32 karakter; erişim jetonlarını imzalar
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# İsteğe bağlı: Google ile giriş. Console'da "Web uygulaması" türünde OAuth istemcisi oluştur ve
# yetkili yönlendirme URI'si olarak <PUBLIC_URL>/v1/auth/google/callback adresini ekle.
# İkisi de boşsa Google düğmesi uygulamada görünmez.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=https://nichevo-api.fatihgo.com
# İsteğe bağlı: sosyal tarama (X + Instagram, yalnızca okuma). İzinli hesap e-postaları, virgülle; BOŞSA özellik kapalı.
SOCIAL_ALLOWED_EMAILS=
# Otomatik takip yenileme aralığı (saat, en az 1) ve kullanılacak tarayıcı (chrome | msedge)
SOCIAL_REFRESH_HOURS=12
SOCIAL_CHROME_CHANNEL=chrome
# Oturum profilinin yeri (varsayılan: nichevo-backend/.social-profile, git'e girmez)
# SOCIAL_PROFILE_DIR=
# İsteğe bağlı: sunucu üzerinden EVREN LLM. Anahtar YALNIZCA burada durur (uygulamaya/cihaza gitmez); izin listesi AI_ALLOWED_EMAILS (boşsa SOCIAL_ALLOWED_EMAILS)
AI_API_KEY=
# AI_ALLOWED_EMAILS=
# Herhangi bir OpenAI uyumlu uç nokta (varsayılan EVREN). Eski adlar EVREN_API_KEY / EVREN_BASE_URL de çalışır.
# AI_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
# AI_MODEL=            # doluysa istemcinin model isteği yok sayılır (örn. OmniRoute için: coding)
# AI_PROVIDER_NAME=    # yalnızca /v1/ai/status'ta görünür (boşsa adresten türetilir)
# İsteğe bağlı: parola sıfırlama ve e-posta doğrulama (6 haneli kod e-postayla). İKİSİ DE doluysa açılır; boşsa kapalı.
# Herhangi bir SMTP sağlayıcısı olur. Kimlik bilgisi yalnızca burada durur.
# SMTP_URL=smtps://kullanici:parola@smtp.ornek.com:465
# MAIL_FROM=Nichevo <no-reply@ornek.com>
