{
  "name": "nichevo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nichevo yerel hesap sunucusu: Fastify + Postgres (Docker)",
  "scripts": {
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "reset-password": "tsx --env-file=.env src/reset-password.ts",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "social:login": "node scripts/social-login.mjs"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "jose": "^6.1.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.0",
    "playwright-core": "^1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  }
}
